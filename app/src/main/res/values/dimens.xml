<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared spacing scale. The layout is deliberately tight: flat sections,
  hairline separators, and rows that stay close to the 44dp touch minimum.
-->
<resources>
    <!-- Screen gutters. -->
    <dimen name="screen_h_padding">16dp</dimen>
    <dimen name="screen_top_padding">0dp</dimen>
    <dimen name="screen_bottom_padding">24dp</dimen>

    <!-- Sections. -->
    <dimen name="section_top_gap">18dp</dimen>
    <dimen name="section_title_bottom">2dp</dimen>

    <!-- Rows. -->
    <dimen name="row_min_height">44dp</dimen>
    <dimen name="row_vertical_padding">8dp</dimen>

    <!-- Status chips. -->
    <dimen name="chip_h_padding">8dp</dimen>
    <dimen name="chip_v_padding">3dp</dimen>
    <dimen name="chip_min_width">56dp</dimen>

    <!-- Header. -->
    <dimen name="header_badge">32dp</dimen>
</resources>
