<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      A card groups one topic on a page. Filled rather than elevated: the page
      background is the "lowest" surface, so a container-low card reads as a
      distinct panel in both light and dark. A hairline outline keeps the edges
      crisp without the heaviness of a shadow.
    -->
    <style name="CardContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/card_gap</item>
        <item name="cardCornerRadius">@dimen/card_corner</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/app_surface</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/app_outline</item>
    </style>

    <!-- Title at the top of a card, led by a small primary accent bar. -->
    <style name="CardTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:drawableStart">@drawable/card_accent</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- One-line explanation under a card title. -->
    <style name="CardSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Clickable list row: copy on the left, a control on the right. -->
    <style name="ListRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/row_min_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">@dimen/row_vertical_padding</item>
        <item name="android:paddingBottom">@dimen/row_vertical_padding</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="RowTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="RowSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:lineSpacingExtra">1dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Hairline rule used inside a card to separate a header from its rows. -->
    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:background">@color/app_outline</item>
    </style>

    <!--
      Pill in the self-check list. The background is tinted at runtime to match
      the state colour, so the accent reads as a chip rather than plain text.
    -->
    <style name="StatusChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">@dimen/chip_min_width</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">@dimen/chip_h_padding</item>
        <item name="android:paddingEnd">@dimen/chip_h_padding</item>
        <item name="android:paddingTop">@dimen/chip_v_padding</item>
        <item name="android:paddingBottom">@dimen/chip_v_padding</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Label on the left of a diagnostics row. -->
    <style name="StatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Value on the right of a diagnostics row. -->
    <style name="StatValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:gravity">end</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
    </style>

    <!-- Compact bottom bar label: small, quiet, no Material letter-spacing. -->
    <style name="NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.0</item>
    </style>

    <!--
      Bottom bar with no active-indicator pill: the selected tab is expressed
      by tint alone (see @color/nav_item_tint), which is the simpler, flatter
      treatment. A zero-sized transparent indicator keeps the view's own layout
      maths intact while drawing nothing.
    -->
    <style name="NavActiveIndicator">
        <item name="android:width">0dp</item>
        <item name="android:height">0dp</item>
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="PreviewButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
</resources>
