<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!--
      Status indicators are the only chroma in the UI: green / red / gray must
      read the same on every device, so they sit outside the Material scheme.
    -->
    <color name="state_ok">#1F7A50</color>
    <color name="state_bad">#B23B32</color>
    <color name="state_idle">#8B9099</color>

    <!--
      Flat surfaces: page and bars share one tone, rows are separated by
      hairlines instead of panels. Night overrides live in values-night.
    -->
    <color name="app_background">#F5F5F6</color>
    <color name="app_surface">#FFFFFF</color>
    <color name="app_surface_muted">#EFEFF1</color>
    <color name="app_outline">#E6E7E9</color>

    <!-- Filled text fields: one step darker than the page so the box reads. -->
    <color name="input_background">#ECEDEF</color>

    <!--
      Fixed "ink" scheme: near-black accent, neutral grays. Deliberately not
      Material You — a developer tool should look the same on every wallpaper.
    -->
    <color name="m3_primary">#1C1D20</color>
    <color name="m3_on_primary">#FFFFFF</color>
    <color name="m3_primary_container">#E9E9EB</color>
    <color name="m3_on_primary_container">#1C1D20</color>

    <color name="m3_secondary">#5B5F66</color>
    <color name="m3_on_secondary">#FFFFFF</color>
    <color name="m3_secondary_container">#ECECEE</color>
    <color name="m3_on_secondary_container">#2A2C30</color>

    <color name="m3_surface">#F5F5F6</color>
    <color name="m3_on_surface">#17181A</color>
    <color name="m3_surface_variant">#ECECEE</color>
    <color name="m3_on_surface_variant">#6C7078</color>
    <color name="m3_outline">#8B9099</color>
    <color name="m3_outline_variant">#E6E7E9</color>

    <color name="m3_surface_container_lowest">#F5F5F6</color>
    <color name="m3_surface_container_low">#EFEFF1</color>
    <color name="m3_surface_container">#E9E9EB</color>
    <color name="m3_surface_container_high">#E3E4E6</color>
    <color name="m3_surface_container_highest">#DDDEE1</color>
</resources>
