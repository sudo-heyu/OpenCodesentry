<?xml version="1.0" encoding="utf-8"?>
<!--
  主页 = the OpenCode web console, served by the desktop bridge and shown in
  a WebView. Until a pairing credential exists, the same page hosts the setup
  prompt; the WebView only ever becomes visible once there is something to
  load.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/webConsole"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_background"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressConsole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/consoleSetup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_header_badge">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_tab_home"
                app:tint="?attr/colorOnPrimary" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvConsoleTitle"
            style="?attr/textAppearanceTitleMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/console_setup_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConsoleBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/console_setup_body"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConsoleScan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minWidth="200dp"
            android:text="@string/console_scan" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConsoleRetry"
            style="@style/Widget.Opencode.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minWidth="200dp"
            android:text="@string/console_retry"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
