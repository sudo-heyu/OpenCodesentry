<?xml version="1.0" encoding="utf-8"?>
<!--
  Flat status page: no panels. Sections are separated by quiet labels and
  1dp hairlines, rows stay at 44dp so the page is dense but still tappable.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_h_padding"
        android:paddingTop="@dimen/screen_top_padding"
        android:paddingEnd="@dimen/screen_h_padding"
        android:paddingBottom="@dimen/screen_bottom_padding">

        <!-- ============ 守护状态 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/viewStatusDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/status_dot" />

            <TextView
                android:id="@+id/tvGuardState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="已停止"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvGuardHint"
            style="@style/RowSubtitle"
            android:layout_marginTop="2dp"
            android:text="打开下面的开关即可常驻后台" />

        <View
            style="@style/Divider"
            android:layout_marginTop="10dp" />

        <LinearLayout style="@style/ListRow">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/RowTitle"
                    android:text="启用守护服务" />

                <TextView
                    style="@style/RowSubtitle"
                    android:text="前台常驻，熄屏也能收到提醒" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvGuardWarning"
            style="@style/RowSubtitle"
            android:layout_marginTop="4dp"
            android:text="已从「最近任务」隐藏，不存在被划掉的问题；若仍被系统清理，无障碍守护与持久任务会自动把它拉回来。" />

        <!-- ============ 连接通道 ============ -->
        <TextView
            style="@style/SectionTitle"
            android:text="连接通道" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/row_min_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/row_vertical_padding"
            android:paddingBottom="@dimen/row_vertical_padding">

            <TextView
                style="@style/RowTitle"
                android:text="状态" />

            <TextView
                android:id="@+id/tvConnection"
                style="@style/StatValue"
                android:text="未启动" />
        </LinearLayout>

        <View style="@style/Divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/row_min_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/row_vertical_padding"
            android:paddingBottom="@dimen/row_vertical_padding">

            <TextView
                style="@style/RowTitle"
                android:text="最近提醒" />

            <TextView
                android:id="@+id/tvLastEvent"
                style="@style/StatValue"
                android:text="—" />
        </LinearLayout>

        <View style="@style/Divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/row_min_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/row_vertical_padding"
            android:paddingBottom="@dimen/row_vertical_padding">

            <TextView
                style="@style/RowTitle"
                android:text="本机 tailnet 地址" />

            <TextView
                android:id="@+id/tvStatusPhoneIp"
                style="@style/StatValue" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLastError"
            style="@style/RowSubtitle"
            android:layout_marginTop="2dp"
            android:textColor="@color/state_bad"
            android:visibility="gone" />

        <!-- ============ 权限自检 ============ -->
        <TextView
            style="@style/SectionTitle"
            android:text="保活与权限自检" />

        <TextView
            style="@style/SectionNote"
            android:text="点任意一行去系统设置里处理" />

        <LinearLayout
            android:id="@+id/rowKeeper"
            style="@style/ListRow"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/RowTitle"
                    android:text="无障碍守护（关键）" />

                <TextView
                    style="@style/RowSubtitle"
                    android:text="被系统清理后自动复活；不读取屏幕内容" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvKeeperState"
                style="@style/StatusChip" />
        </LinearLayout>

        <View style="@style/Divider" />

        <LinearLayout
            android:id="@+id/rowAutostart"
            style="@style/ListRow"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAutostartTitle"
                    style="@style/RowTitle"
                    android:text="自启动" />

                <TextView
                    style="@style/RowSubtitle"
                    android:text="系统不提供查询接口，若你已开启，忽略本行即可" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAutostartState"
                style="@style/StatusChip" />
        </LinearLayout>

        <View style="@style/Divider" />

        <LinearLayout
            android:id="@+id/rowHighPower"
            style="@style/ListRow"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBackgroundTitle"
                    style="@style/RowTitle"
                    android:text="后台运行" />

                <TextView
                    style="@style/RowSubtitle"
                    android:text="在系统设置里允许本应用后台常驻" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHighPowerState"
                style="@style/StatusChip" />
        </LinearLayout>

        <View style="@style/Divider" />

        <LinearLayout
            android:id="@+id/rowBattery"
            style="@style/ListRow"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/RowTitle"
                    android:text="电池优化白名单" />

                <TextView
                    style="@style/RowSubtitle"
                    android:text="Doze 期间仍能收发网络，也是后台自动重启的系统豁免" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBatteryState"
                style="@style/StatusChip" />
        </LinearLayout>

        <View style="@style/Divider" />

        <LinearLayout
            android:id="@+id/rowNotify"
            style="@style/ListRow"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/RowTitle"
                    android:text="通知权限" />

                <TextView
                    style="@style/RowSubtitle"
                    android:text="没有它无法弹出任何提醒" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNotifyState"
                style="@style/StatusChip" />
        </LinearLayout>

        <View style="@style/Divider" />

        <LinearLayout
            android:id="@+id/rowDnd"
            style="@style/ListRow"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/RowTitle"
                    android:text="勿扰穿透（可选）" />

                <TextView
                    style="@style/RowSubtitle"
                    android:text="开启勿扰时仍能提醒你" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDndState"
                style="@style/StatusChip" />
        </LinearLayout>

        <View style="@style/Divider" />

        <LinearLayout style="@style/ListRow">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/RowTitle"
                    android:text="精确闹钟" />

                <TextView
                    style="@style/RowSubtitle"
                    android:text="看门狗定时唤醒的能力" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvExactState"
                style="@style/StatusChip" />
        </LinearLayout>

        <!-- ============ 运行诊断 ============ -->
        <TextView
            style="@style/SectionTitle"
            android:text="运行诊断" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/StatLabel"
                android:text="守护运行时长" />

            <TextView
                android:id="@+id/tvDiagUptime"
                style="@style/StatValue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/StatLabel"
                android:text="自动复活次数" />

            <TextView
                android:id="@+id/tvDiagHeals"
                style="@style/StatValue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/StatLabel"
                android:text="无障碍心跳" />

            <TextView
                android:id="@+id/tvDiagHeartbeat"
                style="@style/StatValue" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearDiagnostics"
            style="@style/Widget.Opencode.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="清零计数" />

        <!-- ============ 动作 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestAlert"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="发送测试提醒" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopAlert"
                style="@style/Widget.Opencode.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="停止响铃" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
