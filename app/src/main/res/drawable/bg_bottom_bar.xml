<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom bar surface with a hairline along its top edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/app_surface" />
        </shape>
    </item>
    <item
        android:height="1dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="@color/app_outline" />
        </shape>
    </item>
</layer-list>
