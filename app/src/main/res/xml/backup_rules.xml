<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules. The app stores the OpenCode service password in the
   SharedPreferences file below, so it is excluded from both cloud backup and
   device-to-device transfer: a credential should not leave the device it was
   typed on. (It is also encrypted at rest, but the Keystore key does not
   travel with a backup, so restoring it would be useless — and the name from
   older builds is excluded too.)
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="sharedpref" path="opencode_notify_secure.xml" />
    <exclude domain="sharedpref" path="opencode_notify.xml" />
</full-backup-content>
