<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- QR scanning for pairing. The camera is optional: the app works fine on
         devices without one as long as credentials are entered by hand. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- Foreground service that keeps the alert channel open. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Battery-optimisation whitelist: the documented way to keep network
         access while the device is in Doze. Sideloaded, so Play policy on
         this permission does not apply. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Exact alarms for the watchdog. USE_EXACT_ALARM is auto-granted for a
         sideloaded alarm-style app; the fallback path asks the user for the
         revocable SCHEDULE_EXACT_ALARM app-op when that is not available. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Lets the app ask to be allowed through Do Not Disturb. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Package visibility (Android 11+): the vendor "自启动" and "后台运行"
         screens live in other packages, and resolveActivity would return null
         without these. One entry per brand the shortcut table targets. -->
    <queries>
        <!-- 小米 / Redmi -->
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.miui.powerkeeper" />
        <!-- 华为 / 荣耀 -->
        <package android:name="com.huawei.systemmanager" />
        <!-- OPPO / 一加 / realme -->
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.coloros.oppoguardelf" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.oneplus.security" />
        <!-- vivo / iQOO -->
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.vivo.abe" />
        <package android:name="com.iqoo.powersaving" />
        <!-- 三星 -->
        <package android:name="com.samsung.android.sm" />
        <package android:name="com.samsung.android.sm_cn" />
        <!-- 魅族 -->
        <package android:name="com.meizu.safe" />
        <!-- 通用 -->
        <package android:name="com.android.settings" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpencodeNotify"
        android:usesCleartextTraffic="true">

        <!--
          excludeFromRecents is the first line of defence, not a cosmetic
          choice. On iQOO/OriginOS a task in the recents list can be swiped
          (which force-stops the package) or swept up by the task cleaner.

          With the task hidden there is no card to swipe, no card to lock, and
          the vendor's "X / 一键清理" does not see the app at all. The app is
          reopened from the launcher icon; launchMode singleTask makes that
          return to the one existing instance instead of stacking new tasks.
        -->
        <activity
            android:name=".MainActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen QR scanner used to pair with the desktop bridge. -->
        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.OpencodeNotify.Scanner" />

        <service
            android:name=".NotifyService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains a notification channel to a self-hosted OpenCode server so the user is alerted on their phone when a coding task finishes or blocks on a permission or question." />
        </service>

        <!--
          The keeper. Bound by system_server with BIND_AUTO_CREATE, which is
          what makes the system recreate this process after a kill. It has no
          UI and observes nothing; see accessibility_service_config.xml.
        -->
        <service
            android:name=".GuardAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Persisted revival job: outlives a process kill and a reboot. -->
        <service
            android:name=".GuardJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".StopAlertReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="app.opencodesentry.action.STOP_ALERT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".WatchdogReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="app.opencodesentry.action.WATCHDOG" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
